# Copy this file to the protected runtime environment location and replace secrets there.
# Never commit real passwords, secret file contents, or machine-specific secret paths.

# Secret file paths: intentionally empty in the repository example.
# Each secret must be a regular file, never a symlink, containing one value with
# no trailing newline and no more than 1024 bytes. On POSIX, keep all secret files
# in one directory owned by the deployment owner with mode 0700, and set each
# secret file to read-only mode 0444. The protected parent prevents other host
# users from traversing to those world-readable bind-mount source files. Use an
# equivalently restricted Windows ACL where POSIX modes are unavailable.
# Local Compose file secrets are bind mounts: service-level uid, gid, and mode
# settings cannot repair host permissions and are intentionally not configured.
# Prefer `printf %s value > file`, then `chmod 0444 file`; do not use echo.
TEMPORAL_POSTGRES_PASSWORD_FILE=
TEMPORAL_POSTGRES_EXPORTER_PASSWORD_FILE=
GRAFANA_ADMIN_PASSWORD_FILE=

# Docker Compose >= 2.17 is required. The only supported exporter-password
# rotation flow is deployment/temporal/scripts/rotate-exporter-password.sh;
# it re-runs role-sync and force-recreates postgres-exporter to reload the file.

# Non-secret database defaults.
TEMPORAL_POSTGRES_DB=temporal
TEMPORAL_POSTGRES_VISIBILITY_DB=temporal_visibility
TEMPORAL_POSTGRES_USER=temporal
TEMPORAL_NAMESPACE=default
TEMPORAL_NAMESPACE_RETENTION=72h
GRAFANA_ADMIN_USER=admin

# Non-secret host nginx relay defaults. Treat these four values as one atomic
# configuration group and generate the runtime override/target/nginx files with
# scripts/configure_temporal_metrics_relay.py before starting Prometheus.
# Production bootstrap requires /etc/medchat/generated to exist as a root-owned,
# non-group/world-writable directory. The relay tool safely creates only the
# final temporal-metrics directory beneath it; it never creates missing trusted
# parents.
# Relay activation is intentionally limited to TEMPORAL_NAMESPACE=default and a
# protected worker environment containing MEDCHAT_TEMPORAL_NAMESPACE=default
# and MEDCHAT_TEMPORAL_DOCKING_QUEUE=medchat-docking. Any mismatch fails closed
# with E_RELAY_RUNTIME_MISMATCH so monitoring cannot target a different queue.
MEDCHAT_TEMPORAL_METRICS_RELAY_SUBNET=172.30.95.0/28
MEDCHAT_TEMPORAL_METRICS_RELAY_GATEWAY=172.30.95.1
MEDCHAT_TEMPORAL_PROMETHEUS_SCRAPE_ADDRESS=172.30.95.2
MEDCHAT_TEMPORAL_METRICS_RELAY_PORT=9466

# Non-secret loopback host-port defaults.
TEMPORAL_POSTGRES_HOST_PORT=5433
TEMPORAL_GRPC_HOST_PORT=7233
TEMPORAL_UI_HOST_PORT=8233
PROMETHEUS_HOST_PORT=9090
GRAFANA_HOST_PORT=3000
