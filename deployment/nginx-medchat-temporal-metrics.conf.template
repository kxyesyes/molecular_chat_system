server {
    listen ${RELAY_GATEWAY}:${RELAY_PORT};
    server_name _;
    access_log off;

    location = /metrics {
        allow ${PROMETHEUS_ADDRESS};
        deny all;
        proxy_pass http://127.0.0.1:9465/metrics;
        proxy_connect_timeout 2s;
        proxy_read_timeout 5s;
        proxy_set_header Authorization "";
        proxy_set_header Cookie "";
    }

    location / { return 404; }
}
