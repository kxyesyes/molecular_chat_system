[Unit]
Description=MedChat Web Service
After=network.target

[Service]
Type=simple
User=medchat
Group=medchat
WorkingDirectory=/opt/medchat/molecular_chat_system
EnvironmentFile=/opt/medchat/molecular_chat_system/.env
ExecStart=/opt/conda/envs/medchat/bin/python main.py --no-reload --host 0.0.0.0 --port 8080
Restart=always
RestartSec=3
TimeoutStartSec=120
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target

