# MedChat HTTP-only public mapping for medchat.tdd-lab.com.
#
# Use this only when the public mapping cannot terminate TLS. Plain HTTP
# exposes cookies, chat content, and API requests; HTTPS/WSS remains preferred.
# Copy this setting into the project .env file used by main.py --env-file .env.
MEDCHAT_INSECURE_HTTP_HOSTS=medchat.tdd-lab.com
