# MedChat 服务运行配置
MEDCHAT_ENV_FILE=.env
MEDCHAT_HOST=127.0.0.1
MEDCHAT_PORT=6001
MEDCHAT_DEBUG=false
MEDCHAT_RELOAD=false
MEDCHAT_WORKERS=1
MEDCHAT_LOG_LEVEL=info
MEDCHAT_LOG_DIR=logs
MEDCHAT_TEMP_DOCKING_DIR=temp_docking
MEDCHAT_SCRATCH_DIR=scratch

# 重计算与上传边界
MEDCHAT_MAX_UPLOAD_BYTES=26214400
MEDCHAT_DOCKING_MAX_BATCH_LIGANDS=100

# 可选：ModelScope API 配置
MODELSCOPE_API_KEY=
MODELSCOPE_BASE_URL=https://api-inference.modelscope.cn/v1/chat/completions
RXN_API_KEY=

# 可选：OpenAI-compatible 外部模型接口
# 将本文件复制为 .env 后填写；.env 已被 Git 忽略。
# 页面“保存并启用”也会把真实配置写入本机 .env，不会修改本模板。
MEDCHAT_LLM_PROVIDER=
MEDCHAT_LLM_STREAM=true
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=https://api.example.com
OPENAI_COMPATIBLE_MODEL=your-model-name

# 可选：Ollama 本地模型服务
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gmm-llama:latest

# 分子对接工具链路径
# Windows 示例:
# MOLECULAR_DOCKING_VINA=C:\path\to\vina.exe
# MOLECULAR_DOCKING_ADFR_BIN=C:\path\to\ADFRsuite\bin
# MOLECULAR_DOCKING_PREPARE_LIGAND=C:\path\to\mk_prepare_ligand.exe
# Linux 示例:
# MOLECULAR_DOCKING_VINA=/opt/conda/envs/medchat/bin/vina
# MOLECULAR_DOCKING_ADFR_BIN=/opt/medchat/tools/ADFRsuite/bin
# MOLECULAR_DOCKING_PREPARE_LIGAND=/opt/conda/envs/medchat/bin/mk_prepare_ligand.py
MOLECULAR_DOCKING_ROOT=
MOLECULAR_DOCKING_VINA=
MOLECULAR_DOCKING_ADFR_BIN=
MOLECULAR_DOCKING_PREPARE_LIGAND=
# 可选：如果 prepare_receptor 不在 ADFR bin 目录内，可以直接指定
MOLECULAR_DOCKING_PREPARE_RECEPTOR=

# 靶点搜索数据库与结构缓存
TARGET_DB_PATH=data/target_db/target_database.sqlite
TARGET_CACHE_DIR=data/target_db/cache

# 可选：反向寻靶 ChEMBL SQLite 数据库
CHEMBL_DB_PATH=
REVERSE_TARGET_DATA_DIR=data/reverse_target

# 可选：活性预测模型与 RAG 索引
ACTIVITY_MODEL_DIR=data/activity/models
RAG_INDEX_PATH=data/molecular_faiss_index.index

# 可选：部署配置文件路径
MEDCHAT_SYSTEMD_SERVICE=deployment/medchat.service
MEDCHAT_NGINX_CONFIG=deployment/nginx-medchat.conf

# Durable Agent state and acceptance evaluation
AGENT_STATE_DB=data/agent_state.sqlite3
AGENT_EVALUATION_OUTPUT=outputs/agent_evaluation/agent_acceptance_report.json
MOLECULAR_GENERATOR_MODEL=gmm-llama:latest

# Agent harness rollout is fail-closed; enable canary explicitly per deployment.
AGENT_HARNESS_MODE=legacy
AGENT_LANGGRAPH_CANARY_PERCENT=0
